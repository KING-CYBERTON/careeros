# CAREEROS: staging server .env template (P0-C03, extended by P1-C01). Copy to .env, chmod 600, replace every
# CHANGE_ME with a fresh value (`openssl rand -hex 32` is URL-safe, so it is safe inside the database URLs).
# Never commit the real .env. Comments are shortened from the repo-root .env.example.

# --- Deployment ---
IMAGE_REPOSITORY="ghcr.io/king-cyberton/careeros"
# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token.
TUNNEL_TOKEN="CHANGE_ME"
APP_URL="https://staging.example.com"
PORT="3000"
# CAREEROS (P2-T03): organization hosts. The request host decides the organization. First-level hosts are covered by
# the free Universal SSL (phase plan D2). Leave unset to turn organization hosts off.
ORG_HOST_PATTERN="{slug}-careeros.ayopa.co.ke"
# The tunnel sets Host correctly, so leave this false (only true behind a proxy that overwrites X-Forwarded-Host).
TRUST_FORWARDED_HOST="false"
# CAREEROS (P2-T06): organization custom domains through Cloudflare for SaaS (phase plan D3). Fill these in after
# Stephen enables Cloudflare for SaaS on the zone (P2-C01); while they are empty the feature stays off.
# CF_SAAS_API_TOKEN: zone-scoped, "SSL and Certificates: Edit" only. CF_SAAS_CNAME_TARGET is the fallback origin name
# that infra/staging/cloudflare.mjs creates: careeros-saas-origin.<your zone domain> (must not match ORG_HOST_PATTERN).
CF_SAAS_API_TOKEN=""
CF_ZONE_ID=""
CF_SAAS_CNAME_TARGET=""

# --- Database roles (P1-C01) ---
# POSTGRES_PASSWORD is the superuser password; only the one-shot db_bootstrap service uses it.
POSTGRES_PASSWORD="CHANGE_ME"
# Passwords for the two roles db_bootstrap creates/updates on every deploy. Use the same values in the URLs below.
CAREEROS_OWNER_PASSWORD="CHANGE_ME"
CAREEROS_APP_PASSWORD="CHANGE_ME"
# The app connects as careeros_app (no superuser, no BYPASSRLS, owns no tables).
DATABASE_URL="postgresql://careeros_app:CHANGE_ME@postgres:5432/postgres"
# Migrations run at app startup as the table owner careeros_owner.
DATABASE_MIGRATION_URL="postgresql://careeros_owner:CHANGE_ME@postgres:5432/postgres"
STRICT_SCHEMA_CHECK="false"

# --- Billing (P3-T04) ---
# Billing is off (none) on staging for now. The spec wants the fake provider here until the real one lands (P3-T05), but
# the staging image runs with NODE_ENV=production (Dockerfile) and the server refuses BILLING_PROVIDER=fake in
# production, so setting it would stop the server at startup. Waiting on the answer to docs/questions.md Q240.
# When allowed: BILLING_PROVIDER="fake" and BILLING_FAKE_SECRET set to a fresh `openssl rand -hex 32`.
BILLING_PROVIDER="none"
BILLING_FAKE_SECRET=""

# --- Email (P6-T02) ---
# Plunk sends every email (verification, sign-in links, invitations, notifications, renewal reminders). Leave
# EMAIL_PROVIDER empty to log emails instead. Setup steps: infra/staging/README.md, "Email through Plunk".
EMAIL_PROVIDER=""
# Plunk dashboard > Settings > API Keys > Secret key (starts with sk_).
PLUNK_SECRET_KEY=""
PLUNK_API_URL="https://next-api.useplunk.com"
# A verified sending address on the staging domain.
EMAIL_FROM_ADDRESS=""
# The same value goes in the Plunk workflow's Webhook step (header x-careeros-webhook-secret): `openssl rand -hex 32`.
PLUNK_WEBHOOK_SECRET=""

# --- Secrets ---
AUTH_SECRET="CHANGE_ME"
ENCRYPTION_SECRET="CHANGE_ME"
# Platform AI (P3-T03): the platform's Claude key. Leave empty to turn platform AI off. Never commit a real key.
ANTHROPIC_API_KEY=""
# P3-T11: "anthropic" (default) or "openrouter" (then set OPENROUTER_API_KEY; no fallback to the Anthropic key).
CAREEROS_AI_PLATFORM_PROVIDER="anthropic"
OPENROUTER_API_KEY=""
CAREEROS_AI_MODEL_GENERATION="claude-sonnet-5-5"
CAREEROS_AI_MODEL_FAST="claude-haiku-5-5"

# --- Storage (SeaweedFS in the compose stack) ---
S3_ACCESS_KEY_ID="CHANGE_ME"
S3_SECRET_ACCESS_KEY="CHANGE_ME"
S3_REGION="us-east-1"
S3_ENDPOINT="http://seaweedfs:8333"
S3_BUCKET="reactive-resume"
S3_FORCE_PATH_STYLE="true"

# --- Redis ---
REDIS_URL="redis://redis:6379"

# --- Flags ---
FLAG_DISABLE_SIGNUPS="false"
FLAG_DISABLE_EMAIL_AUTH="false"
FLAG_ENABLE_GUEST_LOGIN="false"

# Email is intentionally unset in Phase 0/1: the app logs emails instead of sending them.
