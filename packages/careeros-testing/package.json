{
	"name": "@careeros/testing",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"exports": {
		".": "./src/index.ts",
		"./auth-org-inventory": "./src/auth-org-inventory.ts",
		"./cross-org-inventory": "./src/cross-org-inventory.ts",
		"./db": "./src/db.ts",
		"./env": "./src/env.ts",
		"./isolated-db": "./src/isolated-db.ts",
		"./ids": "./src/ids.ts"
	},
	"scripts": {
		"db:test-role": "node scripts/db-test-role.mjs",
		"typecheck": "tsrs --noEmit",
		"test": "vp test run --passWithNoTests",
		"test:coverage": "vp test run --coverage --passWithNoTests",
		"test:ci": "vp test run --reporter=default --reporter=github-actions --reporter=json --reporter=junit --outputFile.json=reports/vitest-results.json --outputFile.junit=reports/vitest-junit.xml --passWithNoTests"
	},
	"dependencies": {
		"@reactive-resume/utils": "workspace:*",
		"pg": "catalog:"
	},
	"devDependencies": {
		"@reactive-resume/config": "workspace:*",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"tsrs": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	}
}
