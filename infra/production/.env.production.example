# CAREEROS: production server .env template (P6-C01). Same names as infra/staging/.env.staging.example, with the
# production values described below. Copy to /opt/careeros/production/.env, chmod 600, and replace every CHANGE_ME with
# a fresh value (`openssl rand -hex 32` is URL-safe, so it is safe inside the database URLs). Never reuse a staging
# value and never commit the real .env. deploy.sh runs preflight.sh on this file and refuses test or unsafe settings.

# --- Core ---
APP_URL="https://app.example.com"
PORT="3000"
AUTH_SECRET="CHANGE_ME"
ENCRYPTION_SECRET="CHANGE_ME"

# --- Deployment ---
IMAGE_REPOSITORY="ghcr.io/king-cyberton/careeros"
# Cloudflare Zero Trust -> Networks -> Tunnels -> the production tunnel (not the staging one) -> token.
TUNNEL_TOKEN="CHANGE_ME"

# --- Organization hosts and Cloudflare for SaaS ---
# The request host decides the organization. Leave unset to turn organization hosts off.
ORG_HOST_PATTERN="{slug}.example.com"
# The tunnel sets Host correctly, so leave this false.
TRUST_FORWARDED_HOST="false"
# Custom domains. While these are empty the feature stays off. CF_SAAS_API_TOKEN is zone-scoped,
# "SSL and Certificates: Edit" only. CF_SAAS_CNAME_TARGET must not match ORG_HOST_PATTERN.
CF_SAAS_API_TOKEN=""
CF_ZONE_ID=""
CF_SAAS_CNAME_TARGET=""

# --- Database (P1-C01 role split) ---
# POSTGRES_PASSWORD is the superuser password; only the one-shot db_bootstrap service uses it.
POSTGRES_PASSWORD="CHANGE_ME"
# Passwords for the two roles db_bootstrap creates/updates on every deploy. Use the same values in the URLs below.
CAREEROS_OWNER_PASSWORD="CHANGE_ME"
CAREEROS_APP_PASSWORD="CHANGE_ME"
# The app serves as careeros_app (no superuser, no BYPASSRLS, owns no tables).
DATABASE_URL="postgresql://careeros_app:CHANGE_ME@postgres:5432/postgres"
# Migrations run at app startup as the table owner careeros_owner.
DATABASE_MIGRATION_URL="postgresql://careeros_owner:CHANGE_ME@postgres:5432/postgres"
# Production stops at startup if the schema has drifted.
STRICT_SCHEMA_CHECK="true"

# --- Storage (SeaweedFS in the compose stack; README "Moving storage to an external bucket" for later) ---
S3_ACCESS_KEY_ID="CHANGE_ME"
S3_SECRET_ACCESS_KEY="CHANGE_ME"
S3_REGION="us-east-1"
S3_ENDPOINT="http://seaweedfs:8333"
S3_BUCKET="reactive-resume"
S3_FORCE_PATH_STYLE="true"

# --- Redis ---
REDIS_URL="redis://redis:6379"

# --- Email (Plunk) ---
# Leave EMAIL_PROVIDER empty to log emails instead (not for a public launch).
EMAIL_PROVIDER="plunk"
PLUNK_SECRET_KEY="CHANGE_ME"
PLUNK_API_URL="https://next-api.useplunk.com"
# A verified sending address on the production domain.
EMAIL_FROM_ADDRESS="CHANGE_ME"
PLUNK_WEBHOOK_SECRET="CHANGE_ME"

# --- Billing (Paystack live keys only) ---
# preflight.sh refuses sk_test_/pk_test_ keys, PAYSTACK_ALLOW_TEST_KEY=true and BILLING_PROVIDER=fake.
# Use "none" until the live Paystack account is ready.
BILLING_PROVIDER="paystack"
PAYSTACK_SECRET_KEY="sk_live_CHANGE_ME"
PAYSTACK_PUBLIC_KEY="pk_live_CHANGE_ME"

# --- AI (platform key and models) ---
# Leave ANTHROPIC_API_KEY empty to turn platform AI off.
ANTHROPIC_API_KEY=""
CAREEROS_AI_MODEL_GENERATION="claude-sonnet-5-5"
CAREEROS_AI_MODEL_FAST="claude-haiku-5-5"

# --- Flags ---
# Never set FLAG_ALLOW_UNSAFE_*, FLAG_ALLOW_FAKE_BILLING or FLAG_DISABLE_API_RATE_LIMIT here: preflight.sh refuses them.
FLAG_DISABLE_SIGNUPS="false"
FLAG_DISABLE_EMAIL_AUTH="false"
FLAG_ENABLE_GUEST_LOGIN="false"
